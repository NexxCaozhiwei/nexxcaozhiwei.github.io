---
const {
  title = "NexxCaozhiwei",
  description = "个人主页、博客、工具导航和服务展示。"
} = Astro.props;
import "../styles/global.css";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">NexxCaozhiwei</a>
      <nav aria-label="主导航">
        <a href="/blog/">博客</a>
        <a href="/tools/">工具</a>
        <a href="/services/">服务</a>
        <a href="/about/">关于</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} NexxCaozhiwei</span>
      <a href="https://github.com/NexxCaozhiwei" target="_blank" rel="noreferrer">GitHub</a>
    </footer>
  </body>
</html>
