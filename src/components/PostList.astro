---
import PostCard from './PostCard.astro';
import type { PostMeta } from '../utils/posts';

interface Props {
  posts: PostMeta[];
  /** 首页把置顶文章单独成区，列表页由调用方保证置顶已经在最前面 */
  showPinned?: boolean;
}

const { posts, showPinned = false } = Astro.props;

const pinnedPosts = showPinned ? posts.filter((post) => post.pinned) : [];
const otherPosts = showPinned ? posts.filter((post) => !post.pinned) : posts;
---

{
  pinnedPosts.length > 0 && (
    <section class="mb-10">
      <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
        <span class="w-1 h-6 bg-primary rounded-full inline-block" />
        置顶文章
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {pinnedPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>
  )
}

{
  otherPosts.length > 0 && (
    <section>
      {pinnedPosts.length > 0 && (
        <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
          <span class="w-1 h-6 bg-primary rounded-full inline-block" />
          文章列表
        </h2>
      )}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {otherPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>
  )
}
