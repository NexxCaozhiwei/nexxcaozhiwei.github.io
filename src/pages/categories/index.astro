---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCategoryBuckets } from '../../utils/posts';
import { taxonomyUrl } from '../../utils/slug';

// 只列出根分类，父级计数已经包含其下所有子分类的文章。
const categories = (await getCategoryBuckets()).filter((bucket) => !bucket.name.includes('/'));
---

<BlogLayout title="分类">
  <h1 class="text-2xl font-bold mb-8 flex items-center gap-2">
    <span class="w-1 h-6 bg-primary rounded-full inline-block" />
    分类
  </h1>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {categories.map((category) => (
      <a
        href={taxonomyUrl('category', category.slug)}
        class="card-hover bg-white dark:bg-[var(--color-card-dark)] rounded-xl shadow-sm p-5 group"
      >
        <h2 class="font-semibold group-hover:text-primary transition-colors">
          {category.displayName}
        </h2>
        <p class="text-sm text-gray-400 dark:text-gray-500 mt-1">
          {category.count} 篇文章
        </p>
      </a>
    ))}
  </div>
</BlogLayout>
