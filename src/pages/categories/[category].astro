---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/PostList.astro';
import { getCategoryBuckets, getPosts, sortForList } from '../../utils/posts';
import { normalizeRouteSegment, taxonomyUrl } from '../../utils/slug';

export async function getStaticPaths() {
  const buckets = await getCategoryBuckets();
  const paths = buckets.map((bucket) => ({ params: { category: bucket.slug } }));

  // 迁移前的旧地址（分类原文名，例如带空格的 `AI 编程`）生成 301 跳转页。
  const canonical = new Set(buckets.map((bucket) => bucket.slug));
  for (const bucket of buckets) {
    const legacy = normalizeRouteSegment(bucket.name);
    if (legacy && legacy !== bucket.slug && !canonical.has(legacy)) {
      paths.push({ params: { category: legacy } });
    }
  }

  return paths;
}

const requested = normalizeRouteSegment(Astro.params.category);

const buckets = await getCategoryBuckets();
const bucket = buckets.find(
  (item) => item.slug === requested || normalizeRouteSegment(item.name) === requested,
);

if (!bucket) {
  return Astro.redirect('/404', 302);
}

const canonicalSegment = bucket.slug;

if (requested !== canonicalSegment) {
  return Astro.redirect(taxonomyUrl('category', canonicalSegment), 301);
}

const posts = sortForList(
  (await getPosts()).filter((post) => {
    const category = post.category;
    if (!category) return false;
    return category === bucket.name || category.startsWith(`${bucket.name}/`);
  }),
);
---

<BlogLayout title={bucket.displayName}>
  <h1 class="text-2xl font-bold mb-8 flex items-center gap-2">
    <span class="w-1 h-6 bg-primary rounded-full inline-block" />
    分类：{bucket.displayName}
    <span class="text-base font-normal text-gray-400">({posts.length} 篇)</span>
  </h1>
  <PostList posts={posts} />
</BlogLayout>
