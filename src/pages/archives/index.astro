---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, sortForList } from '../../utils/posts';

const posts = sortForList(await getPosts());
---

<BlogLayout title="归档">
  <h1 class="text-2xl font-bold mb-8 flex items-center gap-2">
    <span class="w-1 h-6 bg-primary rounded-full inline-block" />
    归档
  </h1>
  <PostList posts={posts} />
</BlogLayout>
