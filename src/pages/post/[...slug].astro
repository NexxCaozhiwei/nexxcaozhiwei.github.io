---
import { getEntry, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPublishedEntries, getCategoryBuckets } from '../../utils/posts';
import { getReadingTime, getWordCount } from '../../utils/readingTime';
import { resolveCover } from '../_imageStore';
import { slugifyTaxonomyName, taxonomyUrl } from '../../utils/slug';

export async function getStaticPaths() {
  const [posts, categories] = await Promise.all([getPublishedEntries(), getCategoryBuckets()]);
  const categorySlug = new Map(categories.map((bucket) => [bucket.name, bucket.slug]));

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      categorySlug: post.data.category ? categorySlug.get(post.data.category) : undefined,
    },
  }));
}

const { slug } = Astro.params;
const { categorySlug } = Astro.props;

// biome-ignore lint/style/noNonNullAssertion: getStaticPaths 只会为已发布文章生成路径
const post = await getEntry('blog', slug!);

if (!post) {
  // 静态构建理论上不会命中：getStaticPaths 只为已发布文章生成路径。
  return Astro.rewrite('/404');
}

const coverSrc = resolveCover('blog', post.id, post.data.cover);

const { Content, headings } = await render(post);

const wordCount = getWordCount(post.body ?? '');
const readingTime = getReadingTime(post.body ?? '');
const category = post.data.category;
const updated = post.data.updated;

function formatDate(d: Date) {
  return d.toISOString().split('T')[0];
}
---

<PostLayout title={post.data.title} description={post.data.description} headings={headings} cover={coverSrc}>
  <header class="mb-8">
    {category && (
      <a
        href={taxonomyUrl('category', categorySlug ?? slugifyTaxonomyName(category))}
        class="inline-block text-sm font-medium text-primary bg-primary/10 px-3 py-1 rounded-full mb-4"
      >
        {category}
      </a>
    )}
    <h1 class="text-3xl font-bold mb-4">{post.data.title}</h1>
    <div class="flex flex-wrap items-center gap-4 text-sm text-gray-400 dark:text-gray-500">
      <time datetime={formatDate(post.data.date)}>
        {formatDate(post.data.date)}
      </time>
      <span>{wordCount} 字</span>
      <span>{readingTime} min read</span>
    </div>
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-4">
        {post.data.tags.map((tag: string) => (
          <a
            href={taxonomyUrl('tag', slugifyTaxonomyName(tag))}
            class="text-xs px-2.5 py-1 rounded-md bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}
    {updated && (
      <p class="text-xs text-gray-400 dark:text-gray-500 mt-2">
        最后更新于 {formatDate(updated)}
      </p>
    )}
  </header>
  <Content />
</PostLayout>
