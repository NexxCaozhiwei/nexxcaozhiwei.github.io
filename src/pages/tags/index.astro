---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getTagBuckets } from '../../utils/posts';
import { taxonomyUrl } from '../../utils/slug';

const tags = await getTagBuckets();
---

<BlogLayout title="标签">
  <h1 class="text-2xl font-bold mb-8 flex items-center gap-2">
    <span class="w-1 h-6 bg-primary rounded-full inline-block" />
    标签
  </h1>
  <div class="flex flex-wrap gap-3">
    {tags.map((tag) => (
      <a
        href={taxonomyUrl('tag', tag.slug)}
        class="card-hover bg-white dark:bg-[var(--color-card-dark)] rounded-xl shadow-sm px-4 py-2.5 group"
      >
        <span class="font-medium group-hover:text-primary transition-colors">
          {tag.name}
        </span>
        <span class="text-xs text-gray-400 dark:text-gray-500 ml-1.5">
          {tag.count}
        </span>
      </a>
    ))}
  </div>
</BlogLayout>
