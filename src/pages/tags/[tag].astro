---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, getTagBuckets, sortForList } from '../../utils/posts';
import { normalizeRouteSegment, taxonomyUrl } from '../../utils/slug';

export async function getStaticPaths() {
  const tagBuckets = await getTagBuckets();
  const paths = tagBuckets.map((bucket) => ({ params: { tag: bucket.slug } }));

  const canonical = new Set(tagBuckets.map((bucket) => bucket.slug));
  for (const bucket of tagBuckets) {
    const legacy = normalizeRouteSegment(bucket.name);
    if (legacy && legacy !== bucket.slug && !canonical.has(legacy)) {
      paths.push({ params: { tag: legacy } });
    }
  }

  return paths;
}

const requested = normalizeRouteSegment(Astro.params.tag);

const tagBuckets = await getTagBuckets();
const bucket = tagBuckets.find(
  (item) => item.slug === requested || normalizeRouteSegment(item.name) === requested,
);

if (!bucket) {
  return Astro.redirect('/404', 302);
}

if (requested !== bucket.slug) {
  return Astro.redirect(taxonomyUrl('tag', bucket.slug), 301);
}

const posts = sortForList((await getPosts()).filter((post) => post.tags.includes(bucket.name)));
---

<BlogLayout title={bucket.name}>
  <h1 class="text-2xl font-bold mb-8 flex items-center gap-2">
    <span class="w-1 h-6 bg-primary rounded-full inline-block" />
    标签：{bucket.name}
    <span class="text-base font-normal text-gray-400">({posts.length} 篇)</span>
  </h1>
  <PostList posts={posts} />
</BlogLayout>
