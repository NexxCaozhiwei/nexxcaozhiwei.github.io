---
import { getPublishedEntries } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedEntries();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { target: `/post/${post.id}/` },
  }));
}

const { target } = Astro.props;
return Astro.redirect(target, 301);
---
