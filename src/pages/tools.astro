---
import BaseLayout from "../layouts/BaseLayout.astro";
import tools from "../data/tools.json";
---
<BaseLayout title="工具导航 | NexxCaozhiwei">
  <section class="page-title">
    <h1>工具导航</h1>
    <p>集中整理常用工具、资源入口和工作流链接。</p>
  </section>

  <section class="grid">
    {tools.map((tool) => (
      <a class="card" href={tool.url} target="_blank" rel="noreferrer">
        <h3>{tool.name}</h3>
        <p>{tool.description}</p>
      </a>
    ))}
  </section>
</BaseLayout>
