---
import BlogLayout from '../layouts/BlogLayout.astro';
import Hero from '../components/Hero.astro';
import PostList from '../components/PostList.astro';
import Pagination from '../components/Pagination.astro';
import { PAGE_SIZE } from '../consts';
import { getPosts, sortForList } from '../utils/posts';

const sorted = sortForList(await getPosts());
const totalPages = Math.ceil(sorted.length / PAGE_SIZE);
const paginatedPosts = sorted.slice(0, PAGE_SIZE);
---

<BlogLayout>
  <Hero />
  <PostList posts={paginatedPosts} showPinned />
  <Pagination currentPage={1} totalPages={totalPages} baseUrl="/" />
</BlogLayout>
