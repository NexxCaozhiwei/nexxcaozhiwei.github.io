---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import { PAGE_SIZE } from '../../consts';
import { getPosts, sortForList } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = sortForList(await getPosts());
  const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));

  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const { page: pageParam } = Astro.params;
const currentPage = Number(pageParam);

const sorted = sortForList(await getPosts());
const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
const start = (currentPage - 1) * PAGE_SIZE;
const paginatedPosts = sorted.slice(start, start + PAGE_SIZE);
---

<BlogLayout title={`第 ${currentPage} 页`}>
  <h1 class="text-2xl font-bold mb-6 text-gray-900 dark:text-gray-100">
    第 {currentPage} 页
  </h1>
  <PostList posts={paginatedPosts} />
  <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/" />
</BlogLayout>
