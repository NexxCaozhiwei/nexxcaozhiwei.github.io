---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortalCard from '../components/PortalCard.astro';
import sites from '../data/portal.json';

const categories = [...new Set(sites.map((site) => site.category))];
const featured = sites.filter((site) => site.featured);
---

<BaseLayout title="传送门" description="收藏一些常用的网站，也留住偶然发现的好去处。">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-10 sm:py-14" data-portal>
    <header class="mb-9">
      <p class="mb-3 text-xs font-semibold tracking-[0.2em] text-primary">BOOKMARKS</p>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">传送门</h1>
      <p class="mt-4 text-sm sm:text-base text-[var(--color-text-secondary)]">收藏一些常用的网站，也留住偶然发现的好去处。</p>
      <p class="mt-3 text-xs text-[var(--color-text-secondary)]">{sites.length} 个网站 · {categories.length} 个分类</p>
    </header>

    <div class="mb-10 space-y-5">
      <label class="block max-w-xl">
        <span class="sr-only">搜索收藏的网站</span>
        <input type="search" data-portal-search placeholder="搜索名称、简介或标签…" class="w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-card)] px-4 py-3 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" />
      </label>
      <div class="flex flex-wrap gap-2" role="group" aria-label="网站分类">
        <button type="button" data-portal-filter="" aria-pressed="true" class="portal-filter rounded-full border px-4 py-2 text-sm transition-colors">全部 <span class="ml-1 opacity-70">{sites.length}</span></button>
        {categories.map((category) => (
          <button type="button" data-portal-filter={category} aria-pressed="false" class="portal-filter rounded-full border px-4 py-2 text-sm transition-colors">{category} <span class="ml-1 opacity-70">{sites.filter((site) => site.category === category).length}</span></button>
        ))}
      </div>
      <p data-portal-status role="status" aria-live="polite" class="text-xs text-[var(--color-text-secondary)]">共 {sites.length} 个网站，点击卡片在新标签页打开。</p>
    </div>

    {featured.length > 0 && (
      <section data-portal-section class="mb-10" aria-label="常用入口">
        <h2 class="mb-5 text-lg font-semibold">常用入口</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">{featured.map((site) => <PortalCard site={site} />)}</div>
      </section>
    )}
    {categories.map((category) => (
      <section data-portal-section class="mb-10" aria-label={category}>
        <h2 class="mb-5 flex items-center gap-3 text-lg font-semibold"><span class="h-5 w-1 rounded-full bg-primary" aria-hidden="true"></span>{category}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">{sites.filter((site) => site.category === category).map((site) => <PortalCard site={site} />)}</div>
      </section>
    ))}
    <div data-portal-empty hidden class="rounded-2xl border border-dashed border-[var(--color-border)] px-6 py-14 text-center">
      <p class="font-medium">暂时没有找到匹配的网站</p>
      <p class="mt-2 text-sm text-[var(--color-text-secondary)]">换个关键词，或重置筛选再看看。</p>
      <button type="button" data-portal-reset class="mt-5 rounded-lg bg-primary/10 px-4 py-2 text-sm text-primary">重置筛选</button>
    </div>
  </div>
</BaseLayout>

<style>
  .portal-filter { border-color: var(--color-border); background: var(--color-card); }
  .portal-filter[aria-pressed='true'] { border-color: var(--color-primary); background: var(--color-primary); color: white; }
  .portal-filter:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
</style>

<script>
  function initPortal() {
    const root = document.querySelector<HTMLElement>('[data-portal]');
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = 'true';
    const input = root.querySelector<HTMLInputElement>('[data-portal-search]')!;
    const filters = root.querySelectorAll<HTMLButtonElement>('[data-portal-filter]');
    const cards = root.querySelectorAll<HTMLAnchorElement>('[data-portal-card]');
    let category = '';

    function update() {
      const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const visible = new Set<string>();
      cards.forEach((card) => {
        card.hidden = Boolean(category && card.dataset.category !== category) || !terms.every((term) => card.dataset.search?.includes(term));
        if (!card.hidden) visible.add(card.href);
      });
      root!.querySelectorAll<HTMLElement>('[data-portal-section]').forEach((section) => {
        section.hidden = !section.querySelector('[data-portal-card]:not([hidden])');
      });
      filters.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.portalFilter === category)));
      root!.querySelector<HTMLElement>('[data-portal-empty]')!.hidden = visible.size > 0;
      root!.querySelector<HTMLElement>('[data-portal-status]')!.textContent = `找到 ${visible.size} 个网站，点击卡片在新标签页打开。`;
    }

    input.addEventListener('input', update);
    filters.forEach((button) => button.addEventListener('click', () => { category = button.dataset.portalFilter || ''; update(); }));
    root.querySelector('[data-portal-reset]')?.addEventListener('click', () => { category = ''; input.value = ''; update(); input.focus(); });
    root.querySelectorAll<HTMLImageElement>('[data-portal-icon]').forEach((icon) => {
      icon.addEventListener('error', () => { icon.hidden = true; });
      if (icon.complete && icon.naturalWidth === 0) icon.hidden = true;
    });
    update();
  }

  initPortal();
  document.addEventListener('astro:page-load', initPortal);
</script>
