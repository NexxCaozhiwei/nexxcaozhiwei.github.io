---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" noindex>
  <section class="py-20 text-center">
    <p class="text-7xl font-bold text-primary/30 select-none">404</p>
    <h1 class="text-2xl font-bold mt-6 mb-3">这个页面不存在</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-8">
      链接可能已经失效，或者文章地址发生了变化。
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="px-5 py-2.5 rounded-full bg-primary text-white text-sm font-medium hover:bg-primary/90 transition-colors"
      >
        回到首页
      </a>
      <a
        href="/archives/"
        class="px-5 py-2.5 rounded-full bg-gray-100 dark:bg-gray-800 text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
      >
        浏览全部文章
      </a>
    </div>
  </section>
</BaseLayout>
